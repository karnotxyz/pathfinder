# syntax=docker/dockerfile:1.7-labs

FROM --platform=$TARGETPLATFORM lukemathwalker/cargo-chef:0.1.73-rust-1.91.1-slim-bookworm AS chef
WORKDIR /usr/src/pathfinder

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ENV LIBSQLITE3_FLAGS="-USQLITE_ENABLE_MEMORY_MANAGEMENT"
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential libzstd-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /usr/src/pathfinder/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json \
    --package pathfinder-prune-converter \
    --bin pathfinder-prune-convert
COPY . .
RUN cargo build --locked --release \
    --package pathfinder-prune-converter \
    --bin pathfinder-prune-convert \
    && cp target/release/pathfinder-prune-convert /usr/local/bin/pathfinder-prune-convert

FROM --platform=$TARGETPLATFORM debian:bookworm-slim AS runner
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 pathfinder \
    && useradd --no-log-init --uid 1000 --gid pathfinder --no-create-home pathfinder
COPY --from=builder /usr/local/bin/pathfinder-prune-convert /usr/local/bin/pathfinder-prune-convert
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/pathfinder-prune-convert"]
